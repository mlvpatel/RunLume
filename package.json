{
  "name": "runlume",
  "version": "0.3.0",
  "description": "Local-first analytics for AI coding sessions, provider cost, code impact, workflow, and timelines.",
  "type": "module",
  "files": [
    "server.mjs",
    "adapters.mjs",
    "analytics.mjs",
    "pricing.json",
    "public/",
    "sample/",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "bin": {
    "runlume": "./server.mjs"
  },
  "scripts": {
    "start": "node server.mjs",
    "sample": "node sample/generate.mjs && node server.mjs --import-dir ./sample-data --sources api-log --all",
    "check": "node --check server.mjs && node --check adapters.mjs && node --check analytics.mjs && node --check public/app.js && node --check scripts/package-smoke.mjs && node --check test/e2e/dashboard.e2e.mjs",
    "test": "node --test test/adapters.test.mjs test/analytics.test.mjs test/server.test.mjs",
    "test:e2e": "node --test test/e2e/dashboard.e2e.mjs",
    "test:package": "node scripts/package-smoke.mjs",
    "capture:demo": "node scripts/capture-demo.mjs"
  },
  "devDependencies": {
    "axe-core": "4.12.1",
    "playwright": "1.62.0"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "agent",
    "analytics",
    "claude-code",
    "codex",
    "cursor",
    "dashboard",
    "gemini",
    "gemini-cli",
    "jsonl",
    "lm-studio",
    "ollama",
    "mistral",
    "nemotron",
    "qwen"
  ],
  "packageManager": "pnpm@11.9.0",
  "author": "Malav Patel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mlvpatel/RunLume.git"
  },
  "bugs": {
    "url": "https://github.com/mlvpatel/RunLume/issues"
  },
  "homepage": "https://github.com/mlvpatel/RunLume#readme"
}
